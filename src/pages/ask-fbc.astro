      }
      return answer('Your full FBC data snapshot',`${DB.members.length} GymDesk membership rows (${uniqueName(DB.members).length} unique names), ${DB.interest.length} interest responses (${uniqueName(DB.interest).length} unique names), ${DB.historical.length} historical master records and ${DB.returning.length} returning-player outreach entries.`,[
        {title:'GymDesk members organized by grade',cards:[],breakdown:countBy(DB.members,'grade').map(([gr,n])=>[gName(Number(gr)),n])},
        {title:'Interested players organized by grade',cards:[],breakdown:countBy(DB.interest,'grade').map(([gr,n])=>[gName(Number(gr)),n])},
        {title:'GymDesk members by region',cards:[],breakdown:countBy(DB.members,'region')}],
        'Do not add the totals: an athlete can appear in multiple source files, and some rows duplicate. Last updated from source snapshots on Nov 16.');
    }
    if(isInterest){
      const leads=DB.interest.filter(x=>!gs.length||gs.includes(x.grade));
      return answer('Your AAU interest list',`${leads.length} interest form responses ${gs.length?'for '+baseContext:'across all grades'}. These are prospective players, NOT paid registrations.`,[{title:'AAU interest form responses',cards:leads.map(leadToCard)}], 'The interest form does not record Cleveland/Pittsburgh region.');
    }
    if(isHistory){
      return answer('Historical players and tryouts',`${historicalFiltered.length} September master records ${gs.length?'in '+baseContext:'across all grades'}.`,[{title:'2026 historical roster',cards:historicalFiltered.map(histToCard)}], 'Proposed team placements and September registration statuses are historical, not current confirmed teams.');
    }
    if(/\b(team|teams|roster|rosters|15u|16u|17u|14u)\b/.test(q)){
      return answer('Your grade-based roster view',`I found ${membersFiltered.length} membership-listed records for ${baseContext}. Players are grouped by membership grade, NOT assigned to confirmed competition teams.`,[{title:'GymDesk grade grouping',cards:membersFiltered.map(memberToCard)}], 'Check current team assignments and graduation eligibility separately. 11th-graders are not automatically excluded.');
    }
    if(contactQuery){
      return answer('Parent and athlete contacts',`Here are ${membersFiltered.length} membership-listed records for ${baseContext}. Verified parent contacts are identified when listed; other account numbers are clearly marked unverified.`,[{title:'Membership-listed contacts',cards:membersFiltered.map(memberToCard)}], 'Only use verified adult numbers with appropriate contact consent; this app does not automatically send SMS.');
    }
    if(/\b(registered|registration|memberships|deposit|member|signups|signup)\b/.test(q)||g!==null||r){
      return answer('GymDesk membership lookup',`${membersFiltered.length} membership-labeled rows in ${baseContext}.`,[{title:'AAU membership records',cards:membersFiltered.map(memberToCard)}], 'Deposit labels are not independently verified payments or confirmed team spots.');
    }
    if(nameMatches.length){return answer('Closest matches',`I found ${nameMatches.length} possible player records in the source data.`,[{title:'Records',cards:nameMatches}], 'If you meant a specific player, try their full name or grade.');}
    return answer('I can search that with a little more detail','Try a player name, grade, region, roster or contact request — for example “Who from 9th grade showed interest?” or “Show the 16U Pittsburgh membership list.”',[], 'I only answer from the loaded FBC records and do not guess missing information.');
  }
  function showAnswer(response){
    const msg=document.createElement('article');msg.className='message answer';const tag=document.createElement('div');tag.className='answerTag';tag.innerHTML='<span class="miniGlow"></span> FBC INTELLIGENCE';msg.appendChild(tag);
    const head=document.createElement('h3');head.className='answerTitle';head.textContent=response.title;msg.appendChild(head);
    if(response.body){const text=document.createElement('p');text.className='answerBody';text.textContent=response.body;msg.appendChild(text);}
    for(const s of response.sections||[]){
      const section=document.createElement('section');section.className='dataSection';const top=document.createElement('div');top.className='dataHead';const label=document.createElement('strong');label.textContent=s.title;top.appendChild(label);const subt=document.createElement('small');subt.textContent=s.breakdown?'GRADE / REGION':`${(s.cards||[]).length} records`;top.appendChild(subt);section.appendChild(top);
      if(s.breakdown){const d=document.createElement('div');d.className='listWrap';for(const [k,v]of s.breakdown){const row=document.createElement('div');row.className='dataRow';const name=document.createElement('div');name.className='rowName';name.textContent=k;const qty=document.createElement('span');qty.className='badge';qty.textContent=v;row.append(name,qty);d.appendChild(row);}section.appendChild(d);}else if(s.cards&&s.cards.length){
        const holder=document.createElement('div');holder.className='listWrap';section.appendChild(holder);
        const renderRange=(from,to)=>{
          for(const c of s.cards.slice(from,to)){
            const row=document.createElement('div');row.className='dataRow';const left=document.createElement('div');left.style.minWidth='0';left.style.flex='1';
            const name=document.createElement('div');name.className='rowName';name.textContent=c.name;left.appendChild(name);
            const meta=document.createElement('div');meta.className='rowMeta';meta.textContent=[c.grade!=null?gName(c.grade):'',c.region&&c.region!=='Unspecified'?c.region:'',c.source].filter(Boolean).join('  ·  ');left.appendChild(meta);
            if(c.secondary){const info=document.createElement('div');info.className='rowRemark';info.textContent=c.secondary;left.appendChild(info);}
            if(c.parentName){const p=document.createElement('div');p.className='rowMeta';p.textContent='Parent/contact: '+c.parentName;left.appendChild(p);}
            if(c.phone){const ph=document.createElement('div');ph.className='phoneRow';const link=document.createElement('a');link.className='phone';link.href='tel:+1'+c.phone;link.textContent=readable(c.phone);ph.appendChild(link);const copyBtn=document.createElement('button');copyBtn.type='button';copyBtn.className='microBtn';copyBtn.textContent='COPY #';copyBtn.onclick=()=>copy(c.phone);ph.appendChild(copyBtn);
              if(c.draft){const txtb=document.createElement('button');txtb.className='microBtn';txtb.textContent='COPY DRAFT';txtb.onclick=()=>copy(c.draft);ph.appendChild(txtb);}left.appendChild(ph);
              if(c.phoneType){const ptype=document.createElement('div');ptype.className='rowMeta';ptype.textContent=c.phoneType;left.appendChild(ptype);}
            }else if(c.otherPhone){const phone=document.createElement('div');phone.className='rowMeta';phone.textContent='Account / tryout number: '+readable(c.otherPhone)+' — parent relationship not verified';left.appendChild(phone);}
            const right=document.createElement('div');right.className='rowRight';const badge=document.createElement('span');badge.className='badge '+(c.badge||'');badge.textContent=c.status||'Source record';right.appendChild(badge);row.append(left,right);holder.appendChild(row);
          }
        };
        const page=35;let shown=Math.min(page,s.cards.length);renderRange(0,shown);
        if(s.cards.length>shown){const more=document.createElement('button');more.type='button';more.className='moreButton';more.textContent=`SHOW MORE · ${s.cards.length-shown} REMAINING`;more.onclick=()=>{const next=Math.min(s.cards.length,shown+page);renderRange(shown,next);shown=next;more.textContent=`SHOW MORE · ${s.cards.length-shown} REMAINING`;if(shown>=s.cards.length)more.remove();};section.appendChild(more);}
        const actions=document.createElement('div');actions.className='answerActions';actions.style.padding='0 13px 12px';
        const namesBtn=document.createElement('button');namesBtn.className='action';namesBtn.type='button';namesBtn.textContent='COPY ALL NAMES';namesBtn.onclick=()=>copy(s.cards.map(x=>x.name).join('\n'));actions.appendChild(namesBtn);
        const phoneNums=[...new Set(s.cards.map(x=>x.phone).filter(Boolean))];if(phoneNums.length){const phonesBtn=document.createElement('button');phonesBtn.className='action';phonesBtn.type='button';phonesBtn.textContent=`COPY ${phoneNums.length} CONTACT #s`;phonesBtn.onclick=()=>copy(phoneNums.join('\n'));actions.appendChild(phonesBtn);}
        const csvBtn=document.createElement('button');csvBtn.className='action';csvBtn.type='button';csvBtn.textContent='EXPORT CSV';csvBtn.onclick=()=>downloadCSV(s.cards,s.title);actions.appendChild(csvBtn);section.appendChild(actions);
      }else{const empty=document.createElement('p');empty.className='answerBody';empty.style.padding='12px 16px';empty.textContent='No records found in this source for those filters.';section.appendChild(empty);}
      msg.appendChild(section);
    }
    if(response.note){const note=document.createElement('p');note.className='answerNote';note.textContent=response.note;msg.appendChild(note);}
    $('#chat').appendChild(msg);$('#chat').scrollTop=$('#chat').scrollHeight;
  }
  function downloadCSV(cards,label){const cols=['Player','Grade','Region','Source','Status','Verified contact','Contact description','Notes'];const rows=cards.map(r=>[r.name,r.grade==null?'':gName(r.grade),r.region||'',r.source,r.status||'',r.phone||'',r.phoneType||'',r.secondary||'']);const enc=v=>'"'+String(v??'').replace(/"/g,'""')+'"';const csv='\uFEFF'+[cols,...rows].map(r=>r.map(enc).join(',')).join('\r\n');const blob=new Blob([csv],{type:'text/csv;charset=utf-8;'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='FBC_'+label.toLowerCase().replace(/[^a-z0-9]+/g,'_').slice(0,34)+'.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),4000);toast('Private CSV exported to your device');}
  function ask(value, fromVoice=false){const q=txt(value);if(!q)return null;if(!DB){toast('Unlock private data to ask questions');return null;}const welcome=$('#welcome');if(welcome)welcome.remove();const message=document.createElement('div');message.className='message user';const bubble=document.createElement('div');bubble.className='bubble';bubble.textContent=q;message.appendChild(bubble);$('#chat').appendChild(message);$('#question').value='';$('#question').style.height='auto';const res=answerQuery(q);showAnswer(res);if(fromVoice)voiceAnswer(res);return res;}
  $('#askForm').addEventListener('submit',e=>{e.preventDefault();ask($('#question').value);});
  $('#question').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('#askForm').requestSubmit();}});
  $('#question').addEventListener('input',e=>{e.target.style.height='auto';e.target.style.height=Math.min(150,e.target.scrollHeight)+'px';});
  document.addEventListener('click',e=>{const b=e.target.closest('[data-q]');if(b)ask(b.getAttribute('data-q'));});
  $('#aboutBtn').onclick=()=>ask('What information do you have on file?');
  $('#lockBtn').onclick=async()=>{voiceWanted=false;haltVoice();await clearKey();DB=null;location.href='/ask-fbc/';};
  $('#unlockBtn').onclick=unlockFromField;$('#keyInput').addEventListener('keydown',e=>{if(e.key==='Enter')unlockFromField();});
  function setVoiceStatus(mode, extra=''){
    const states={
      on:['LISTENING · HANDS-FREE','Speak naturally. Ask about players, signups, grades, teams or parent numbers.','LISTENING'],
      starting:['STARTING VOICE','Connecting to your microphone…','STARTING'],
      waiting:['ONE-TIME MICROPHONE STEP','Tap anywhere once and allow microphone access. Then just talk.','TAP ONCE TO ALLOW'],
      speaking:['ANSWERING OUT LOUD','When I finish speaking, I will listen for your next question.','SPEAKING'],
      paused:['VOICE PAUSED','When you return to this tab, listening can resume.','PAUSED'],
      error:['MICROPHONE UNAVAILABLE','Check Safari microphone permission or use the text box.','VOICE ERROR'],
      off:['HANDS-FREE IS OFF','Enable once to let FBC listen for questions automatically.','VOICE OFF'],
      unsupported:['VOICE NOT SUPPORTED','Try updated Safari. You can still type every question.','VOICE UNAVAILABLE']
    };
    const [heading,help,short]=states[mode]||states.error;
    $('#voiceHeadline').textContent=heading;
    $('#voiceHelp').textContent=extra||help;
    $('#voiceState').textContent=short;
    $('#topVoiceText').textContent=short+' · PRIVATE DATA';
    $('#voiceOrb').classList.toggle('active',mode==='on');
    $('#voiceOrb').classList.toggle('speaking',mode==='speaking');
    $('#voiceDeck')?.classList.toggle('on',mode==='on');
    $('#voiceBtn').classList.toggle('listening',mode==='on');
    $('#voiceBtn').setAttribute('aria-pressed',String(voiceWanted&&voiceAvailable));
    $('#handsFreeToggle').textContent=voiceWanted&&voiceAvailable?'PAUSE':'ENABLE';
    $('#handsFreeToggle').setAttribute('aria-pressed',String(voiceWanted&&voiceAvailable));
    $('#voiceSoundToggle').textContent=voiceReplies?'🔊':'🔇';
    $('#voiceSoundToggle').setAttribute('aria-pressed',String(voiceReplies));
    $('#topVoicePulse').style.background=mode==='on'?'#c5ff57':(mode==='waiting'?'#ffaa61':'#718580');
  }
  function haltVoice(cancelTalking=true){
    clearTimeout(voiceRetry);clearTimeout(voiceFlushTimer);
    voiceRetry=null;voiceFlushTimer=null;voiceBuffer='';
    const r=recognize;recognize=null;voiceRunning=false;voiceStarting=false;
    if(r){try{r.stop();}catch{}}
    if(cancelTalking){clearTimeout(voiceNarrationTimer);voiceSpeaking=false;try{window.speechSynthesis?.cancel();}catch{}}
  }
  function setHandsFree(on){
    voiceWanted=!!on&&voiceAvailable;
    saveVoicePref('fbc-handsfree-enabled-v1',voiceWanted?'on':'off');
    voiceAttempts=0;voiceNeedsGesture=false;voiceDenied=false;
    if(voiceWanted){setVoiceStatus('starting');startContinuousVoice(true);}
    else {haltVoice();setVoiceStatus(voiceAvailable?'off':'unsupported');}
  }
  function planVoiceRestart(delay=500){
    if(!DB||!voiceWanted||voiceSpeaking||voiceNeedsGesture||document.visibilityState!=='visible')return;
    clearTimeout(voiceRetry);
    voiceRetry=setTimeout(()=>{voiceRetry=null;startContinuousVoice(false);},delay);
  }
  function startContinuousVoice(userGesture=false){
    if(!DB||!voiceWanted||!voiceAvailable||recognize||voiceSpeaking||document.visibilityState!=='visible')return;
    if(voiceNeedsGesture&&!userGesture){setVoiceStatus('waiting');return;}
    const Speech=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!Speech){setVoiceStatus('unsupported');return;}
    try{
      const r=new Speech();recognize=r;voiceStarting=true;voiceNeedsGesture=false;
      r.lang='en-US';r.continuous=true;r.interimResults=true;r.maxAlternatives=1;
      r.onstart=()=>{
        if(recognize!==r)return;
        voiceRunning=true;voiceStarting=false;voiceDenied=false;
        $('#voiceTranscript').textContent='';setVoiceStatus('on');
      };
      r.onresult=(event)=>{
        if(!voiceWanted||voiceSpeaking||recognize!==r)return;
        let final='';let interim='';
        for(let j=event.resultIndex||0;j<event.results.length;j++){
          const hit=event.results[j],part=String(hit[0]?.transcript||'').trim();
          if(!part)continue;
          if(hit.isFinal)final+=(final?' ':'')+part;
          else interim+=(interim?' ':'')+part;
        }
        if(final){
          voiceAttempts=0;
          voiceBuffer=(voiceBuffer+' '+final).trim();
          clearTimeout(voiceFlushTimer);
          voiceFlushTimer=setTimeout(flushVoiceWords,650);
        }
        $('#voiceTranscript').textContent=(voiceBuffer||interim)?'HEARD · '+(voiceBuffer||interim).slice(0,120):'';
      };
      r.onerror=(event)=>{
        if(recognize!==r)return;
        const code=String(event?.error||'unknown');
        if(code==='not-allowed'||code==='service-not-allowed'||code==='permission-denied'){
          voiceNeedsGesture=true;voiceDenied=true;setVoiceStatus('waiting','Safari may need one tap and microphone permission. Tap the screen to try again.');
        }else if(code==='audio-capture'){
          voiceNeedsGesture=true;setVoiceStatus('error','No microphone detected. Enable Safari microphone access and tap the screen to retry.');
        }else if(code==='network'||code==='language-not-supported'){
          voiceAttempts++;
          if(voiceAttempts>=MAX_VOICE_RETRIES){voiceNeedsGesture=true;setVoiceStatus('error','The browser speech service cannot connect. Tap once to retry or type instead.');}
          else setVoiceStatus('starting','Reconnecting voice recognition…');
        }
        // 'no-speech' and 'aborted' are normal termination conditions; onend restarts.
      };
      r.onend=()=>{
        if(recognize!==r)return;
        recognize=null;voiceRunning=false;voiceStarting=false;
        if(!voiceWanted||!DB){setVoiceStatus('off');return;}
        if(voiceSpeaking){setVoiceStatus('speaking');return;}
        if(document.visibilityState!=='visible'){setVoiceStatus('paused');return;}
        if(voiceNeedsGesture){setVoiceStatus(voiceDenied?'waiting':'error');return;}
        setVoiceStatus('starting');
        planVoiceRestart(Math.min(8000,450*(voiceAttempts+1)));
      };
      setVoiceStatus('starting');
      r.start();
    }catch(err){
      recognize=null;voiceStarting=false;voiceRunning=false;voiceNeedsGesture=true;
      setVoiceStatus('waiting','Tap anywhere once to allow hands-free microphone access.');
    }
  }
  function flushVoiceWords(){
    voiceFlushTimer=null;
    const raw=voiceBuffer.trim();voiceBuffer='';
    if(!raw||!DB||!voiceWanted)return;
    $('#voiceTranscript').textContent='';
    // Optional wake phrase: "Hey FBC". Normal questions work without it.
    let query=raw.replace(/^(?:(?:hey|hi|okay|ok)\s+)?(?:ask\s+)?(?:f\s*b\s*c|friga)(?:[\s,.!?]+|$)/i,'').trim();
    if(!query)return;
    if(/^(?:stop listening|pause listening|go to sleep|turn off (?:the )?microphone|mute the microphone)\b/i.test(query)){
      setHandsFree(false);toast('FBC stopped listening');return;
    }
    if(/^(?:turn (?:the )?sound off|quiet mode|stop talking|silent mode)\b/i.test(query)){
      voiceReplies=false;saveVoicePref('fbc-handsfree-sound-v1','off');setVoiceStatus('on');return;
    }
    if(/^(?:turn (?:the )?sound on|speak answers|talk to me)\b/i.test(query)){
      voiceReplies=true;saveVoicePref('fbc-handsfree-sound-v1','on');setVoiceStatus('on');return;
    }
    if(query===voiceLastText&&Date.now()-voiceLastAt<2300)return;
    voiceLastText=query;voiceLastAt=Date.now();
    ask(query,true);
  }
  function voiceAnswer(reply){
    if(!voiceReplies||!window.speechSynthesis||!window.SpeechSynthesisUtterance||!reply)return;
    const totals=(reply.sections||[]).reduce((sum,sec)=>sum+(sec.cards?.length||0),0);
    let spoken=(reply.body||reply.title||'I found those records.').replace(/\s+/g,' ').trim();
    if(!spoken)spoken=reply.title||'I found those records.';
    // Say a short response while keeping full rosters and private numbers on the screen.
    if(spoken.length>280)spoken=spoken.slice(0,277).replace(/\s+\S*$/,'')+'.';
    if(totals>0&&!/record|player|found|result|listed|matched/i.test(spoken))spoken=`I found ${totals} records. `+spoken;
    if(!voiceWanted||document.visibilityState!=='visible')return;
    voiceSpeaking=true;
    // Prevent recognizing our own voice while speaking, and resume automatically after.
    if(recognize){try{recognize.stop();}catch{}}
    setVoiceStatus('speaking');
    try{
      window.speechSynthesis.cancel();
      const sentence=new SpeechSynthesisUtterance(spoken);
      sentence.lang='en-US';sentence.rate=1.08;sentence.pitch=1.0;
      let ended=false;
      const done=()=>{
        if(ended)return;ended=true;clearTimeout(voiceNarrationTimer);voiceSpeaking=false;
        if(voiceWanted&&DB){setVoiceStatus('starting');planVoiceRestart(280);}else setVoiceStatus('off');
      };
      sentence.onend=done;sentence.onerror=done;
      voiceNarrationTimer=setTimeout(done,30000);
      window.speechSynthesis.speak(sentence);
    }catch{voiceSpeaking=false;setVoiceStatus('starting');planVoiceRestart(500);}
  }
  $('#handsFreeToggle').onclick=()=>setHandsFree(!voiceWanted);
  $('#voiceBtn').onclick=()=>setHandsFree(!voiceWanted);
  $('#voiceSoundToggle').onclick=()=>{
    voiceReplies=!voiceReplies;saveVoicePref('fbc-handsfree-sound-v1',voiceReplies?'on':'off');
    $('#voiceSoundToggle').textContent=voiceReplies?'🔊':'🔇';
    $('#voiceSoundToggle').setAttribute('aria-pressed',String(voiceReplies));
    toast(voiceReplies?'Spoken answers enabled':'Spoken answers muted');
  };
  // A new microphone grant on iOS may require a trusted user gesture.
  // This handler makes an ordinary tap anywhere suffice rather than a mic-button tap.
  document.addEventListener('pointerdown',event=>{
    if(!voiceWanted||!DB||!voiceNeedsGesture||recognize)return;
    if(event.target.closest('#handsFreeToggle,#voiceBtn,#voiceSoundToggle,#lockBtn,#unlockBtn'))return;
    voiceNeedsGesture=false;voiceDenied=false;voiceAttempts=0;startContinuousVoice(true);
  },{capture:true});
  document.addEventListener('visibilitychange',()=>{
    if(document.visibilityState!=='visible'){
      haltVoice();if(voiceWanted)setVoiceStatus('paused');
    }else if(voiceWanted&&DB){voiceAttempts=0;startContinuousVoice(false);}
  });
  window.addEventListener('pagehide',()=>haltVoice());

  // URL fragment is processed entirely in-browser; immediately clear it to avoid leaving it in history/referrers.
  const fromURL=new URLSearchParams(location.hash.replace(/^#/,''));const key=fromURL.get('key');
  if(key){history.replaceState(null,'',location.pathname+location.search);const raw=kmask(key);if(raw)unlock(null,raw);else $('#unlockError').textContent='The secure link contained an invalid unlock key.';}
  else getSavedKey().then(k=>{if(k)unlock(k,null);});
})();
</script>
</body>
</html>