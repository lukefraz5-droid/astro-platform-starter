  function leadToCard(r){return {name:r.name,grade:r.grade,region:r.region,source:'Interest form · row '+r.sourceRow,phone:r.parentPhone,phoneType:'Contact entered in interest form',secondary:r.school?'School: '+r.school:'',status:r.membershipNameMatch?'Matched by name':'No November name match',badge:r.membershipNameMatch?'blue':'amber',draft:lookupDraft(r.name,r.parentPhone),parentName:''};}
