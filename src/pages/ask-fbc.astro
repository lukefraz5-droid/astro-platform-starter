  function findMatches(q,results,max=25){const stripped=q.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g,' ').replace(/[^a-z\d\- ]/g,' ').split(/\s+/).filter(w=>w&&w.length>=2&&!nameStop.has(w)&&!/^\d+(st|nd|rd|th|u)?$/.test(w));if(!stripped.length)return[];const scored=[];for(const item of results){const name=nrm(item.name);const full=nrm(stripped.join(' '));let score=0;if(full&&name.includes(full))score+=20;if(stripped.every(t=>name.includes(nrm(t))))score+=14;for(const t of stripped){if(name.includes(nrm(t)))score+=t.length>=4?5:2;}if(score>=5&&(stripped.length<=1||stripped.every(t=>name.includes(nrm(t)))))scored.push([score,item]);}return scored.sort((a,b)=>b[0]-a[0]).slice(0,max).map(x=>x[1]);}
