---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<meta name="theme-color" content="#071013"/>
<meta name="robots" content="noindex,nofollow,noarchive"/>
<meta name="referrer" content="no-referrer"/>
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; form-action 'none'; base-uri 'none'"/>
<title>ASK FBC — Private Intelligence</title>
<style is:global>

:root{--bg:#070e11;--panel:#10191c;--panel2:#142124;--line:#24363a;--text:#eefcf4;--muted:#90a6a5;--lime:#c5ff57;--limeDark:#8cd240;--amber:#ffaa61;--red:#ff8479;--soft:#213033;--shadow:0 14px 44px #0005;color-scheme:dark;font-family:'DM Sans',system-ui,-apple-system,Arial,sans-serif}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text)}body{background:radial-gradient(ellipse 760px 550px at 47% -12%,#183c3469,transparent 75%),radial-gradient(ellipse 650px 550px at 100% 63%,#15313a46,transparent 75%),var(--bg);overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(#b6ff6d08 1px,transparent 1px),linear-gradient(90deg,#b6ff6d08 1px,transparent 1px);background-size:44px 44px;mask-image:linear-gradient(to bottom,#0007,#0000);z-index:0}
button,input,textarea{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible,a:focus-visible{outline:2px solid var(--lime);outline-offset:3px}button:disabled{opacity:.45;cursor:not-allowed}a{color:inherit;text-decoration:none}
.app{position:relative;z-index:1;max-width:1780px;margin:auto;min-height:100dvh;display:flex;flex-direction:column}
.header{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:0 34px;gap:15px;background:#07101394;backdrop-filter:blur(20px);position:sticky;top:0;z-index:20}
.identity{display:flex;align-items:center;gap:13px;min-width:0}.emblem{width:49px;height:49px;background:var(--lime);color:#071013;display:grid;place-items:center;border-radius:14px;font-weight:1000;font-size:21px;letter-spacing:-.12em;transform:skew(-5deg);box-shadow:0 0 32px #baff4938}.brandname{font-size:17px;letter-spacing:.11em;font-weight:800}.brandsub{color:var(--muted);font-size:10px;letter-spacing:.22em;margin-top:3px;text-transform:uppercase}.headerRight{display:flex;align-items:center;gap:10px;min-width:0}.pill{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:#122124;border-radius:999px;padding:9px 13px;color:var(--muted);font-size:10px;font-weight:700;letter-spacing:.08em;white-space:nowrap}.pulse{height:7px;width:7px;background:var(--lime);border-radius:50%;box-shadow:0 0 0 3px #c5ff571e,0 0 14px #c5ff57a8}.headerBtn{border:1px solid var(--line);background:transparent;color:var(--text);padding:10px 13px;border-radius:11px;font-size:12px;font-weight:700}
.columns{display:grid;grid-template-columns:260px minmax(0,1fr) 295px;flex:1;min-height:calc(100dvh - 82px)}.sidebar{border-right:1px solid var(--line);padding:28px 18px 20px;display:flex;flex-direction:column;gap:24px}.sideLabel{font-size:10px;letter-spacing:.19em;color:#6f8b89;font-weight:800;text-transform:uppercase;margin:0 10px 13px}.sideNav{display:flex;flex-direction:column;gap:5px}.sideButton{display:flex;gap:12px;align-items:center;width:100%;border:0;text-align:left;background:transparent;color:var(--muted);padding:13px 14px;border-radius:11px;font-size:13px;font-weight:650;transition:background .2s,color .2s}.sideButton:hover{background:#172a2a;color:var(--text)}.sideButton.active{background:#21382c;color:var(--lime);box-shadow:inset 3px 0 var(--lime)}.sideButton b{font-weight:800;font-size:16px;opacity:.8}.sidebarFoot{margin-top:auto;border:1px solid #314642;background:#122522;border-radius:16px;padding:17px}.sidebarFoot .svgicon{color:var(--lime);font-size:22px}.sidebarFoot strong{display:block;margin:11px 0 7px;font-size:13px}.sidebarFoot p{font-size:11px;color:var(--muted);line-height:1.55;margin:0}.smallLink{background:none;border:none;color:var(--lime);font-size:12px;padding:8px 0;text-align:left;font-weight:700}
.center{min-width:0;display:flex;flex-direction:column;max-height:calc(100dvh - 82px)}.stage{padding:27px 32px 0;display:flex;align-items:center;justify-content:space-between;gap:14px}.eyebrow{font-size:10px;letter-spacing:.22em;font-weight:800;color:var(--lime)}.stageTitle{font-size:24px;font-weight:700;letter-spacing:-.05em;font-family:'Space Grotesk',sans-serif;margin:6px 0 0}.stageMeta{color:#7d9c97;font-size:11px}.chat{flex:1;overflow-y:auto;min-height:0;padding:14px 32px 25px;scroll-behavior:smooth}.chat::-webkit-scrollbar{width:7px}.chat::-webkit-scrollbar-thumb{background:#314b49;border-radius:20px}.welcome{padding:26px 0 12px;max-width:720px}.orb{width:76px;height:76px;border-radius:25px;display:grid;place-items:center;color:var(--lime);font-size:30px;font-weight:700;background:radial-gradient(circle at 32% 28%,#274b40,#142e2e 65%,#0d1719);border:1px solid #3b5e54;box-shadow:0 0 0 8px #c5ff5706,0 0 80px #8cdf6341;transform:rotate(-6deg)}.orb span{transform:rotate(6deg)}.hello{font-family:'Space Grotesk',sans-serif;font-size:clamp(30px,4vw,49px);letter-spacing:-.064em;line-height:1.13;font-weight:700;margin:30px 0 14px}.hello em{color:var(--lime);font-style:normal}.lede{color:var(--muted);max-width:595px;line-height:1.67;font-size:15px}.promptGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:27px}.prompt{background:linear-gradient(120deg,#152327,#0f191b);border:1px solid #2a3d41;color:#e3eee7;text-align:left;padding:16px 17px;border-radius:14px;min-height:85px;transition:transform .15s,border-color .15s;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;gap:12px;font-weight:650;font-size:12px;line-height:1.45}.prompt:hover{border-color:#9ddd59;transform:translateY(-2px)}.prompt .symbol{font-size:20px;color:var(--lime);line-height:1}.welcomeFoot{font-size:10px;color:#6f8985;line-height:1.5;margin-top:21px}
.message{max-width:960px;margin:18px 0}.message.user{display:flex;justify-content:flex-end}.bubble{max-width:85%;border-radius:16px;padding:13px 17px;font-size:13px;line-height:1.6;background:linear-gradient(120deg,#294336,#263b32);border:1px solid #4e644d;color:#f2ffe6;box-shadow:var(--shadow)}.answer{padding:0 0 12px;animation:rise .22s ease-out}@keyframes rise{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}.answerTag{display:flex;align-items:center;gap:8px;margin-bottom:12px;color:var(--lime);font-size:10px;font-weight:850;letter-spacing:.18em;text-transform:uppercase}.answerTag .miniGlow{height:7px;width:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 12px #b7fb6c}.answerTitle{font-size:24px;font-family:'Space Grotesk',sans-serif;letter-spacing:-.045em;font-weight:700;margin:0 0 9px;line-height:1.25}.answerBody{color:#b8cac5;line-height:1.7;font-size:13px;margin:0 0 13px}.answerNote{font-size:11px;line-height:1.6;color:#a1aead;border-left:2px solid #baff64;padding:6px 0 6px 11px;margin:14px 0}.answerActions{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0 16px}.action{border:1px solid #34504b;background:#1b2a2b;color:#e9f8e8;border-radius:9px;padding:8px 11px;font-size:11px;font-weight:750}.action:hover{border-color:var(--lime)}.action.accent{background:#c3ff5b;color:#132010;border-color:#c3ff5b}.dataSection{margin-top:19px;border:1px solid #243e3c;border-radius:15px;overflow:hidden;background:#0e191a}.dataHead{background:#142324;padding:14px 17px;display:flex;align-items:center;justify-content:space-between;gap:10px}.dataHead strong{font-size:13px}.dataHead small{font-size:10px;color:#9bb0ae}.listWrap{max-height:430px;overflow:auto}.dataRow{border-top:1px solid #213234;padding:13px 17px;display:flex;justify-content:space-between;align-items:flex-start;gap:14px}.dataRow:first-child{border-top:0}.rowName{font-size:13px;font-weight:700;line-height:1.45}.rowMeta{color:#8eaaa5;font-size:10px;line-height:1.5;margin-top:4px}.rowRemark{color:#d4e5de;font-size:11px;margin-top:5px}.rowRight{display:flex;align-items:flex-end;flex-direction:column;gap:6px;flex-shrink:0}.badge{border:1px solid #40564b;border-radius:6px;padding:4px 7px;color:var(--lime);font-size:10px;font-weight:700;white-space:nowrap}.badge.amber{color:var(--amber);border-color:#5e4438}.badge.blue{color:#91d3e6;border-color:#38565c}.phoneRow{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:8px}.phone{text-decoration:none;color:#bbfa72;font-size:12px;font-variant-numeric:tabular-nums;white-space:nowrap}.microBtn{font-size:10px;border:1px solid #40544d;background:#1a2b29;color:#e5f1e7;border-radius:7px;padding:5px 8px;white-space:nowrap}.microBtn:hover{border-color:var(--lime)}.moreButton{width:100%;padding:12px;color:var(--lime);font-weight:700;background:#132322;border:0;border-top:1px solid #294340;font-size:12px}
.composer{padding:12px 32px 22px;background:linear-gradient(0deg,#070f12 52%,#070f1200);position:relative;z-index:2}.composerShell{display:flex;gap:9px;align-items:flex-end;min-height:68px;border:1px solid #52705b;background:#142326;border-radius:16px;padding:9px 11px 9px 15px;box-shadow:0 0 0 4px #baff5a07,0 18px 50px #0005}.composerShell:focus-within{border-color:#baff62;box-shadow:0 0 0 4px #baff5a18}.composer textarea{resize:none;min-height:40px;max-height:150px;flex:1;width:100%;padding:8px 0;line-height:1.5;background:transparent;border:0;outline:0;color:#f0fff4;font-size:14px}.composer textarea::placeholder{color:#7d9391}.sendButton{height:45px;min-width:45px;border:0;border-radius:11px;background:var(--lime);color:#0c1b0b;font-size:22px;font-weight:800}.micButton{height:45px;min-width:42px;border:1px solid #344c4b;border-radius:11px;background:#1a3030;color:var(--lime);font-size:19px}.micButton.listening{background:#5c322c;color:#ffc3ad;animation:bleep .8s infinite alternate}@keyframes bleep{from{box-shadow:0 0 5px #e36e6e}to{box-shadow:0 0 22px #ec6666aa}}.hint{display:flex;gap:8px;justify-content:space-between;color:#728a88;font-size:10px;padding:11px 4px 0}
.insights{border-left:1px solid var(--line);padding:27px 20px;display:flex;flex-direction:column;gap:17px}.insightsHeader{font-size:10px;letter-spacing:.21em;font-weight:800;color:#8ca8a1}.insight{border:1px solid #2b3e40;background:linear-gradient(140deg,#142328,#0b1719);border-radius:15px;padding:16px 17px}.insight .tag{font-size:10px;color:#90a79f;letter-spacing:.11em;font-weight:700}.insight .value{font-family:'Space Grotesk',sans-serif;font-size:37px;font-weight:700;letter-spacing:-.07em;margin:5px 0;color:#f2fff3}.insight .value small{font-size:12px;color:#a8c59a;letter-spacing:0;font-weight:500}.insight .detail{font-size:11px;color:#8aa29e;line-height:1.5}.insight.alert{background:linear-gradient(145deg,#233022,#131a18);border-color:#4a6045}.insight.alert .value{color:var(--lime)}.infoBlock{font-size:11px;color:#99a9a5;line-height:1.65}.infoBlock strong{color:#e4eee7}.sourceTime{color:var(--lime);font-weight:700}.insightFooter{margin-top:auto;padding:15px;border:1px dashed #3e554c;border-radius:13px;color:#93a9a3;font-size:11px;line-height:1.5}.insightFooter b{display:block;color:#c9e6c6;margin-bottom:7px}
.overlay{position:fixed;inset:0;z-index:100;background:#050c0deF;backdrop-filter:blur(18px);display:flex;align-items:center;justify-content:center;padding:20px}.unlock{max-width:500px;width:100%;padding:35px;border:1px solid #46634e;background:linear-gradient(135deg,#172925,#0b171a);border-radius:25px;box-shadow:0 20px 120px #000d,0 0 70px #b4ff3c16}.lockIcon{display:grid;place-items:center;width:59px;height:59px;border-radius:16px;color:var(--lime);font-size:27px;background:#293d2c;border:1px solid #668057}.unlock h1{font-family:'Space Grotesk',sans-serif;font-size:34px;letter-spacing:-.06em;margin:18px 0 8px}.unlock p{color:#9db0a6;font-size:13px;line-height:1.65}.keylabel{display:block;font-size:11px;color:#d2e4d7;font-weight:750;margin:24px 0 8px}.keyfield{border:1px solid #4b655d;background:#0c1a1b;color:#eaffdc;padding:13px;border-radius:10px;width:100%;font-family:monospace;font-size:12px;letter-spacing:.02em}.unlockButton{background:var(--lime);color:#08170d;border:0;border-radius:11px;font-weight:850;width:100%;padding:15px;margin-top:12px}.unlockError{font-size:12px;color:#ffb3a3;min-height:16px;margin-top:10px;line-height:1.45}.unlockFoot{border-top:1px solid #345049;margin-top:22px;padding-top:17px;color:#93aba0;font-size:11px;line-height:1.6}.hidden{display:none!important}.toaster{position:fixed;z-index:130;bottom:110px;left:50%;transform:translateX(-50%);background:#d0ff8d;color:#082012;padding:11px 18px;border-radius:30px;font-size:12px;font-weight:700;box-shadow:0 10px 30px #0008;max-width:85vw;text-align:center}
@media(max-width:1280px){.columns{grid-template-columns:218px minmax(0,1fr) 250px}.header{padding:0 25px}.sidebar{padding:26px 13px}.insights{padding:25px 14px}.chat{padding:12px 23px 22px}.stage{padding:22px 23px 0}.composer{padding:12px 23px 20px}}
@media(max-width:1070px){.columns{grid-template-columns:210px minmax(0,1fr)}.insights{display:none}.center{max-height:calc(100dvh - 82px)}.header{padding:0 22px}}
@media(max-width:700px){.header{height:67px;padding:0 16px}.emblem{width:41px;height:41px;border-radius:12px;font-size:18px}.brandname{font-size:13px}.brandsub{font-size:8px;letter-spacing:.1em}.headerRight .pill{display:none}.headerBtn{padding:8px 10px;font-size:11px}.columns{display:block;min-height:calc(100dvh - 67px)}.sidebar{display:none}.center{height:calc(100dvh - 67px);max-height:none}.stage{padding:21px 18px 4px}.stageTitle{font-size:20px}.stageMeta{font-size:10px}.chat{padding:10px 18px 18px}.welcome{padding-top:17px}.orb{width:65px;height:65px;font-size:27px;border-radius:20px}.hello{font-size:35px;margin:23px 0 10px}.lede{font-size:13px}.promptGrid{gap:8px;margin-top:24px}.prompt{padding:12px;min-height:96px;font-size:11px}.composer{padding:8px 13px max(13px,env(safe-area-inset-bottom))}.composerShell{min-height:61px;border-radius:14px;padding:7px 8px 7px 12px}.composer textarea{font-size:16px}.sendButton,.micButton{height:43px;min-width:40px}.hint{padding-top:7px}.answerTitle{font-size:21px}.bubble{max-width:92%}.rowRight{max-width:40%}.phoneRow{gap:5px}.dataRow{padding:12px}.unlock{padding:25px}.unlock h1{font-size:30px}}

.voiceDeck{margin:16px 32px 6px;padding:12px 14px;border:1px solid #34514c;border-radius:18px;background:linear-gradient(115deg,#162925,#0b171a);display:flex;gap:15px;align-items:center;min-height:102px;box-shadow:0 4px 24px #0004;position:relative;overflow:hidden;flex-shrink:0}
.voiceDeck:before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 160px 90px at 9% 40%,#b7ff5820,transparent 85%);pointer-events:none}
.voiceDeck.on{border-color:#8fc96a;box-shadow:0 0 0 2px #b5ff4b16,0 4px 30px #0006}
.voiceOrb{width:73px;height:73px;flex:0 0 73px;border-radius:50%;display:grid;place-items:center;position:relative;background:radial-gradient(circle at 35% 35%,#2b493c,#0b181b);border:1px solid #50775c;box-shadow:0 0 26px #8bd8621c;color:#b4e38f}
.voiceCore{position:relative;z-index:2;font-size:30px;text-shadow:0 0 20px #a8f66d77}
.voiceOrb .wave{position:absolute;inset:8px;border:1px solid #afff8360;border-radius:50%;opacity:0;transform:scale(.7);pointer-events:none}
.voiceOrb.active .wave{animation:waveExpand 2.2s infinite ease-out}.voiceOrb.active .wave2{animation-delay:1.1s}
.voiceOrb.speaking{background:radial-gradient(circle at 35% 35%,#49522c,#233220);color:#f2ffbc}
@keyframes waveExpand{0%{transform:scale(.7);opacity:.6}100%{transform:scale(1.5);opacity:0}}
.voiceDetails{display:flex;flex-direction:column;gap:4px;min-width:0;flex:1;position:relative;z-index:1}
.voiceDetails strong{font-size:12px;letter-spacing:.13em;color:#c4ff64;font-weight:900}
.voiceDetails span{color:#9fb8b0;font-size:11px;line-height:1.4}
.voiceDetails .voiceTranscript{color:#e2ffb4;font-size:11px;font-weight:700;letter-spacing:.03em;max-height:27px;overflow:hidden}
.voiceControls{display:flex;gap:6px;align-items:center;flex-shrink:0;position:relative;z-index:1}
.voiceControls button{border:1px solid #496449;border-radius:10px;min-height:40px;font-size:11px;font-weight:800;padding:10px 13px}
.voiceSwitch{background:#c4ff64;color:#142016;min-width:77px}.voiceSwitch[aria-pressed="true"]{background:#2a4539;color:#d7ffc1}
.voiceSound{background:#243632;color:#ccedc8}
@media(max-width:1280px){.voiceDeck{margin:14px 23px 6px}}
@media(max-width:700px){.voiceDeck{margin:10px 13px 4px;padding:9px 10px;min-height:77px;gap:10px;border-radius:14px}.voiceOrb{width:54px;height:54px;flex-basis:54px}.voiceCore{font-size:24px}.voiceDetails strong{font-size:10px;letter-spacing:.08em}.voiceDetails span{font-size:10px;line-height:1.25}.voiceControls{gap:4px}.voiceControls button{padding:8px;min-height:36px;font-size:10px}.voiceSwitch{min-width:52px}}
</style>
</head>
<body>
<div class="app">
<header class="header">
  <div class="identity"><div class="emblem">FBC</div><div><div class="brandname">ASK FBC<span style="color:var(--lime)">.</span></div><div class="brandsub">Private Basketball Intelligence</div></div></div>
  <div class="headerRight"><div class="pill" id="topVoicePill"><span class="pulse" id="topVoicePulse"></span><span id="topVoiceText">SECURE · VOICE STANDBY</span></div><button class="headerBtn" id="aboutBtn" type="button">DATA SOURCES</button><button class="headerBtn" id="lockBtn" type="button" title="Lock the private player data">LOCK ⟲</button></div>
</header>
<div class="columns">
  <aside class="sidebar">
    <div><div class="sideLabel">COMMAND CENTER</div><nav class="sideNav">
    <button class="sideButton active" data-q="Show my AAU numbers" type="button"><b>⌘</b> Ask FBC</button>
    <button class="sideButton" data-q="Show all GymDesk memberships by grade" type="button"><b>▤</b> Member Database</button>
    <button class="sideButton" data-q="Who showed interest but has no November membership match?" type="button"><b>◎</b> Interest Leads</button>
    <button class="sideButton" data-q="Show historical players missing in the new GymDesk export" type="button"><b>◫</b> Missing Signups</button>
    <button class="sideButton" data-q="Show returning players from last year" type="button"><b>↗</b> Returning Players</button>
    <button class="sideButton" data-q="Show outreach drafts" type="button"><b>✉</b> Parent Outreach</button>
    <button class="sideButton" data-q="Show possible duplicates" type="button"><b>⌁</b> Data Review</button>
    </nav></div>
    <div class="sidebarFoot"><div class="svgicon">◉</div><strong>YOUR REAL DATA. ZERO GUESSWORK.</strong><p>All searches happen in this browser using your encrypted FBC snapshots. Nothing is automatically sent to families.</p><button class="smallLink" data-q="What information do you have on file?" type="button">View data coverage →</button></div>
  </aside>
  <main class="center">
    <div class="stage"><div><div class="eyebrow">THE DATA KNOWS.</div><h2 class="stageTitle">Your basketball universe, one question away.</h2></div><div class="stageMeta" id="dateBadge">SNAPSHOT · NOV 16, 2026</div></div>
    <section class="voiceDeck" id="voiceDeck" aria-label="FBC hands-free voice assistant">
      <div class="voiceOrb" id="voiceOrb" aria-hidden="true"><span class="voiceCore">◉</span><span class="wave wave1"></span><span class="wave wave2"></span></div>
      <div class="voiceDetails"><strong id="voiceHeadline">HANDS-FREE MODE</strong><span id="voiceHelp">I am setting up your microphone. Speak normally once it is active.</span><span id="voiceTranscript" class="voiceTranscript" aria-live="off"></span></div>
      <div class="voiceControls"><button class="voiceSwitch" type="button" id="handsFreeToggle" aria-pressed="false" title="Turn continuous hands-free listening on or off">ENABLE VOICE</button><button class="voiceSound" type="button" id="voiceSoundToggle" aria-pressed="true" title="Turn spoken answers on or off">🔊</button></div>
    </section>
    <div id="chat" class="chat" role="log" aria-live="polite" aria-label="Ask FBC conversation">
      <div class="welcome" id="welcome">
        <div class="orb"><span>✳</span></div>
        <h1 class="hello">Ask me <em>anything</em><br/>about your players.</h1>
        <p class="lede">Grades. Memberships. Tryout history. Parent contacts. Players who still need a follow-up. Your information is already here — just ask a question or use the microphone.</p>
        <div class="promptGrid">
          <button class="prompt" type="button" data-q="Show all my 9th graders and their parent contacts"><span class="symbol">↗</span><span>“Show me all my 9th graders and their contacts.”</span></button>
          <button class="prompt" type="button" data-q="Who hasn't signed up yet?"><span class="symbol">⊗</span><span>“Who hasn’t signed up yet?”</span></button>
          <button class="prompt" type="button" data-q="Give me a grade-by-grade breakdown"><span class="symbol">▥</span><span>“Give me a grade-by-grade breakdown.”</span></button>
          <button class="prompt" type="button" data-q="Who were my returning Frazierhoops players?"><span class="symbol">⌁</span><span>“Who were my returning Frazierhoops players?”</span></button>
        </div><div class="welcomeFoot">FBC MEMBER EXPORT + AAU INTEREST + HISTORIC 2026 MASTER + RETURNING ROSTERS · PRIVATE VIEW</div>
      </div>
    </div>
