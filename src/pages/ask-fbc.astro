  function memberToCard(r){const guardian=(r.parentContacts||[]).find(x=>x.phone&&/parent|guardian/i.test(x.relationship));const needsReview=r.needsAthleteNameReview;return {name:r.name,grade:r.grade,region:r.region,source:'GymDesk · row '+r.sourceRow,phone:guardian?.phone||'',otherPhone:r.memberPhone||'',phoneType:guardian?'Parent / guardian listed':'Member/account number — not verified as parent',secondary:r.membership||'',status:needsReview?'ATHLETE NAME NEEDS REVIEW':(r.isMembershipListed?'Membership label · deposit listed':'Non-AAU record'),badge:needsReview?'amber':'blue',parentName:guardian?.name||'',draft:''};}
