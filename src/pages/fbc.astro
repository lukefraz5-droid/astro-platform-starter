*{box-sizing:border-box}body{margin:0}button,input,textarea,select{font:inherit}button,a{touch-action:manipulation;-webkit-tap-highlight-color:transparent}button,a.button{cursor:pointer}button:disabled{opacity:.4;cursor:not-allowed}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #a9bb91;outline-offset:3px}input,textarea,select{font-size:16px}button,.button{border:1px solid var(--line);background:white;color:var(--ink);border-radius:11px;padding:12px 16px;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;font-weight:650}button.primary,.button.primary{background:var(--ink);border-color:var(--ink);color:white}button.accent{background:var(--accent);border-color:var(--accent);color:white}.link{border:0;background:none;color:var(--muted);padding:10px 5px}.small{font-size:12px;color:var(--muted);line-height:1.55}.eyebrow{font-size:10px;letter-spacing:.16em;font-weight:750;color:var(--muted);text-transform:uppercase}header{max-width:1120px;margin:auto;padding:23px 24px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:15px}.brand{display:flex;align-items:center;gap:12px}.mark{background:var(--ink);color:white;border-radius:12px;font-size:16px;font-weight:850;padding:12px 10px;letter-spacing:-.06em}.brand strong{display:block;font-size:15px}.brand small{display:block;color:var(--muted);font-size:11px;margin-top:3px}.pill{border:1px solid var(--line);background:white;border-radius:30px;padding:7px 10px;font-size:11px;white-space:nowrap}.pill:before{content:'';display:inline-block;background:#689252;width:6px;height:6px;margin-right:6px;border-radius:50%}main{max-width:1120px;margin:auto;padding:34px 24px 155px}.hero{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:26px}h1{font-size:clamp(32px,5vw,48px);letter-spacing:-.055em;line-height:1.08;font-weight:720;margin:10px 0 13px}h1 span{color:var(--accent)}.hero p{font-size:14px;color:var(--muted);line-height:1.6;margin:0;max-width:530px}.source{text-align:right;font-size:12px;color:var(--muted);line-height:1.65;flex-shrink:0}.source strong{font-size:26px;color:var(--ink);display:block;letter-spacing:-.04em}.notice{border:1px solid var(--line);border-radius:12px;padding:14px 16px;font-size:12px;line-height:1.6;background:#eeefe8;margin-bottom:22px}.notice.warning{background:#fff3dd;border-color:#e2d4b8}.columns{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start}.card{background:white;border:1px solid var(--line);border-radius:18px;overflow:hidden;padding:22px}.card+.card{margin-top:18px}h2{font-size:19px;letter-spacing:-.025em;margin:0 0 18px;display:flex;gap:11px;align-items:center}.step{font-size:11px;background:var(--soft);border:1px solid var(--line);border-radius:50%;width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center}.filters{display:grid;grid-template-columns:1fr 126px;gap:9px}.field{display:block;font-size:12px;color:var(--muted);margin-bottom:12px}.field input,.field select,.field textarea{display:block;width:100%;border:1px solid var(--line);border-radius:10px;padding:12px;background:#fbfbf8;color:var(--ink);margin-top:7px;min-width:0}.field textarea{resize:vertical;line-height:1.55;min-height:125px}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:0 0 8px}.toolbar button{font-size:12px}.contacts{max-height:340px;overflow:auto;overscroll-behavior:contain;border-block:1px solid var(--line)}.contact{display:flex;align-items:start;gap:12px;padding:13px 2px;border-bottom:1px solid #eceee6;cursor:pointer}.contact:last-child{border:0}.contact input,.check input,.mode input{accent-color:var(--accent);width:18px;height:18px;flex-shrink:0;margin:2px 0 0}.contact strong{font-size:13px;font-weight:650}.contact small{display:block;font-size:11px;color:var(--muted);margin-top:4px;line-height:1.35}.contact .phone{font-variant-numeric:tabular-nums;color:var(--ink)}details{font-size:13px}summary{cursor:pointer;font-weight:650;line-height:1.5;padding:14px 0}.manual{margin-top:8px}.templates{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}.templates button{border-radius:24px;min-height:35px;padding:7px 11px;font-size:11px;background:var(--soft)}#message{min-height:165px}.under{display:flex;justify-content:space-between;gap:8px;margin-top:-4px}.mode{border:1px solid var(--line);border-radius:12px;display:flex;padding:14px;gap:11px;margin-bottom:9px;cursor:pointer}.mode:has(input:checked){border-color:var(--ink);background:#f6f7f2}.mode strong{display:block;font-size:13px}.mode small{display:block;font-size:11px;line-height:1.5;color:var(--muted);margin-top:4px}.check{display:flex;gap:11px;font-size:12px;line-height:1.55;cursor:pointer;margin-top:18px}.check input{margin-top:2px}.setup{border-top:1px solid var(--line);margin-top:14px}.setup ol{padding-left:20px;line-height:1.65;color:var(--muted);font-size:12px}.setup li{margin-bottom:12px}.setup code{font-size:11px;color:var(--ink);background:var(--soft);padding:2px 3px;border-radius:3px}.setup a{color:var(--ink)}.blocked{margin-top:18px}.sticky{position:fixed;bottom:0;left:0;right:0;z-index:10;background:rgba(247,246,242,.97);border-top:1px solid var(--line);padding:15px 24px max(15px,env(safe-area-inset-bottom));backdrop-filter:blur(10px)}.sticky-inner{max-width:1072px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:14px}.sticky strong{font-size:14px;display:block}.sticky small{font-size:11px;color:var(--muted);display:block;margin-top:4px}.sticky button{min-width:220px}dialog{border:1px solid var(--line);border-radius:20px;width:calc(100% - 28px);max-width:580px;max-height:88dvh;overflow:auto;padding:24px;color:var(--ink);background:#fff;box-shadow:0 25px 80px #0003}dialog::backdrop{background:#18201899;backdrop-filter:blur(3px)}dialog h2{margin:10px 0 14px;font-size:25px}dialog .row{display:flex;gap:9px;flex-wrap:wrap;margin-top:15px}.close{float:right;border:0;background:var(--soft);padding:8px 13px;min-height:36px}.preview{font:inherit;line-height:1.65;background:#f3f4ee;border:1px solid var(--line);border-radius:12px;padding:16px;width:100%;min-height:130px;white-space:pre-wrap;word-break:break-word;resize:vertical;font-size:14px;color:var(--ink)}.recipient-review{font-size:12px;line-height:1.8;max-height:155px;overflow:auto;white-space:pre-line;word-break:break-word}.target{border:1px solid var(--line);border-radius:12px;padding:16px;margin:15px 0}.target strong{display:block;font-size:19px;letter-spacing:-.02em}.target small{display:block;color:var(--muted);font-size:12px;margin:5px 0}.target span{font-size:20px;letter-spacing:.02em}.status{font-size:12px;color:var(--muted);line-height:1.6;margin:13px 0 0}.full{width:100%}.hidden,[hidden]{display:none!important}#toast{position:fixed;z-index:50;bottom:105px;left:50%;transform:translateX(-50%);background:#222820;color:white;padding:13px 18px;border-radius:12px;max-width:calc(100% - 32px);width:max-content;font-size:13px;line-height:1.5;box-shadow:0 5px 20px #0003}footer{margin-top:26px;max-width:800px}.data-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.data-actions button{font-size:12px}
@media(max-width:700px){header{padding:17px 18px}.brand strong{font-size:13px}.pill{font-size:10px;padding:6px 8px}main{padding:25px 16px 145px}.hero{display:block;margin-bottom:20px}h1{font-size:37px}.hero p{font-size:13px}.source{text-align:left;display:flex;align-items:baseline;gap:7px;flex-wrap:wrap;margin-top:18px}.source strong{font-size:20px;display:inline}.source span{font-size:11px}.columns{grid-template-columns:1fr;gap:17px}.card{padding:18px;border-radius:15px}.contacts{max-height:260px}.sticky{padding:12px 16px max(12px,env(safe-area-inset-bottom))}.sticky button{min-width:0;font-size:13px;padding:13px 18px}.sticky strong{font-size:13px}.sticky small{font-size:10px;max-width:175px;line-height:1.4}.filters{grid-template-columns:1fr 108px}.source #source-date{width:100%;margin:0}dialog{padding:20px}.row>.button,.row>button{flex:1}.contact strong{font-size:14px}.contact small{font-size:12px}}
