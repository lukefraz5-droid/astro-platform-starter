import { gunzipSync } from 'node:zlib';
export const prerender = false;
// Family data is supplied only to trusted production builds, never committed.
// Keep Netlify team-login protection enabled for all deploy contexts.
const encoded = import.meta.env.FBC_TEXT_CONTACTS_GZIP || '';
let snapshot = { contacts: [], blocked: [], updated: '', count: 0 };
let dataReady = false;
try {
  if (encoded) {
    const decoded = JSON.parse(gunzipSync(Buffer.from(encoded, 'base64')).toString('utf8'));
    if (!Array.isArray(decoded.contacts) || !Array.isArray(decoded.blocked)) throw new Error('Invalid snapshot');
    snapshot = decoded;
    dataReady = true;
  }
} catch { /* Fail closed: never substitute sample people or unverified data. */ }
const boot = JSON.stringify({ ...snapshot, dataReady }).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
